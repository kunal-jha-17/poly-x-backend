# Copy to .env for local runs (never commit .env). On Render, set these in the dashboard instead.

# --- browser access --------------------------------------------------------------------------------
# Exact origin(s) of the frontend, comma separated, no trailing slash.
CORS_ORIGINS=http://localhost:5173
# Optional: a regex for preview deployments, e.g. https://poly-x-[a-z0-9-]+\.vercel\.app
# CORS_ORIGIN_REGEX=

# --- demo safety -----------------------------------------------------------------------------------
# 1 = approve each scenario's default policy at startup, so a restarted server is never "no policy".
POLYX_AUTOARM=1

# --- cloud model (optional). Any OpenAI-compatible endpoint. Default: Groq + the open-weight gpt-oss-120b ---
GROQ_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_LABEL=Cloud open-weight model

# --- local / self-hosted model (optional). Any OpenAI-compatible endpoint ------------------------------
# Ollama on the same machine as this server:
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:3b
# LOCAL_LLM_TIMEOUT_S=60
# Which provider `auto` tries first (the rule parser is always the last resort):
# LLM_PROVIDER_ORDER=local,cloud
# 1 = no model at all (failure drill): everything runs on the deterministic rule parser.
# POLYX_DISABLE_LLM=1

# --- runtime model switch (optional) ---------------------------------------------------------------
# Enables PUT /api/v1/models/local so you can point a hosted server at your laptop's tunnel without a redeploy.
# Use a long random string. Leave empty to keep the endpoint off.
POLYX_ADMIN_TOKEN=

# --- limits (defaults shown) -----------------------------------------------------------------------
# RATE_LIMIT_PER_MIN=300
# RATE_LIMIT_MODEL_PER_MIN=60
# MAX_BODY_BYTES=65536
# RATE_LIMIT_DISABLED=1      # only for bench_e2e.py against your own server
